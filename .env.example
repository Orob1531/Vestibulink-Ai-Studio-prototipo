# GEMINI_API_KEY: Required for Gemini AI API calls (extração auxiliar de editais).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Segredo HMAC-SHA256 usado no backend para assinar tokens de sessão.
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"

# WHATSAPP_API_TOKEN: Token opcional para integração futura de envio automático via provedor WhatsApp.
WHATSAPP_API_TOKEN=""

# SMTP_HOST / EMAIL_API_KEY: Credenciais opcionais para envio transacional de alertas por e-mail.
SMTP_HOST=""
EMAIL_API_KEY=""
